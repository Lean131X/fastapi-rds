# Variables de entorno necesarias para conectarse a la base de datos en Amazon RDS.
# Copiar este archivo como .env y reemplazar los valores.
# El archivo .env NO se sube al repositorio (esta en el .gitignore).

DB_USER=postgres
DB_PASSWORD=aqui_va_la_contrasena
DB_HOST=nombre-instancia.xxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=fastapi_db
